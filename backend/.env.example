# Port and Environment
PORT=8080
NODE_ENV=production

# Database Connection (Render PostgreSQL provides DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true
TYPEORM_SYNC=false

# Optional Individual DB Parameters (if not using DATABASE_URL)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=expensemngr_nest

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key

# CORS Whitelist (comma-separated origins, or * for open, *.vercel.app is automatically allowed)
CORS_ORIGIN=https://your-frontend.vercel.app
